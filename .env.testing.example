APP_ENV=testing
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CRMLeader_test
DB_USERNAME=root
DB_PASSWORD=

# Copie este arquivo para .env.testing (git-ignored) e gere sua própria
# APP_KEY com `php artisan key:generate --env=testing`. DB_DATABASE deve
# apontar para um banco ISOLADO do banco de dev padrão (CRMLeader) — o
# RefreshDatabase usado pela suite de testes apaga e recria esse banco a
# cada execução. Nunca aponte para o banco de dev compartilhado.
